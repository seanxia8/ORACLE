Executable = /bin/sh
Arguments = run.sh

Output = scripts/train_full_a100/probe_topas.$(Cluster).out
Error = scripts/train_full_a100/probe_topas.$(Cluster).err
Log = scripts/train_full_a100/probe_topas.$(Cluster).log
stream_output = True
stream_error = True

transfer_input_files = run.sh, scripts, reconstruction_model, uv.lock, pyproject.toml
transfer_output_files = full_training_probe_topas.ok
transfer_output_remaps = "full_training_probe_topas.ok=scripts/train_full_a100/full_training_probe_topas.ok"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

+RequestWalltime = 1800
RequestCPUs = 2
RequestMemory = 16000
request_disk = 20000000
request_GPUs = 1
+RemoteJob = True
use_x509userproxy = True
requirements = (TARGET.CloudSite =?= "topas") && ((TARGET.GPUs_DeviceName =?= "NVIDIA A100-PCIE-40GB") || (TARGET.GPUs_DeviceName =?= "Tesla V100S-PCIE-32GB"))
rank = ifThenElse(TARGET.GPUs_DeviceName =?= "NVIDIA A100-PCIE-40GB", 100, 10)
accounting_group = DELight

Universe = docker
docker_image = cverstege/alma9-gridjob

getenv = USER, USE_USER, WANDB_API_KEY, X509_USER_PROXY
environment = "JOB_MODE=full_probe SITE_MODE=topas WANDB_MODE=disabled RECONSTRUCTION_WANDB_RUN=0 RECONSTRUCTION_DISABLE_TORCH_COMPILE=1"

Queue
