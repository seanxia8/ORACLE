# Generated by scripts/train_compact_l40s/submit.sh
Executable = /bin/sh
Arguments = run.sh

Output = scripts/train_compact_l40s/train.$(Cluster).out
Error = scripts/train_compact_l40s/train.$(Cluster).err
Log = scripts/train_compact_l40s/train.$(Cluster).log
stream_output = True
stream_error = True

transfer_input_files = run.sh,scripts,reconstruction_model,uv.lock,pyproject.toml,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_100_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_10_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_200_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_20_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_500_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/ER/ER_traces_energy_50_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_100_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_10_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_200_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_20_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_500_batch_0000.h5,/ceph/dwong/transformer/.condor_data/compact_l40s/NR/NR_traces_energy_50_batch_0000.h5
transfer_output_files = artifacts, training_job_summary.json
transfer_output_remaps = "training_job_summary.json=scripts/train_compact_l40s/training_job_summary.$(Cluster).json"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

+RequestWalltime = 43200
RequestCPUs = 8
RequestMemory = 64000
request_disk = 50000000
request_GPUs = 1
+RemoteJob = True
use_x509userproxy = False
requirements = (TARGET.CloudSite =?= "BwForCluster-Nemo2") && (TARGET.GPUs_DeviceName =?= "NVIDIA L40S")
accounting_group = delight

Universe = vanilla
+SingularityImage = "docker://cverstege/alma9-gridjob"

getenv = USER, USE_USER, WANDB_API_KEY
environment = "JOB_MODE=h5_transferred H5_ENERGIES=10,20,50,100,200,500 H5_FILES_PER_ENERGY_RECOIL=1 WANDB_MODE=disabled RECONSTRUCTION_MODEL_VARIANT=pairwise_channel_masking RECONSTRUCTION_RECOIL_CLASSIFICATION=1 RECONSTRUCTION_SPATIAL_TARGET_INDICES=0,1 RECONSTRUCTION_SCALAR_LOSS_WEIGHTS=1.0,1.0,1.0 RECONSTRUCTION_NUM_EPOCHS=20 RECONSTRUCTION_EXPECTED_H5_EVENTS_PER_FILE=10 RECONSTRUCTION_EVAL_STEP_PERIOD=10 RECONSTRUCTION_EVAL_NUM_BATCHES=6 RECONSTRUCTION_SAVE_CHECKPOINT_PERIOD=60 RECONSTRUCTION_TOTAL_BATCH_SIZE=16 RECONSTRUCTION_DEVICE_BATCH_SIZE=4 RECONSTRUCTION_NUM_WORKERS=4 RECONSTRUCTION_MAX_OPEN_H5_FILES=12 RECONSTRUCTION_AMP_DTYPE=auto RECONSTRUCTION_SEED=42 RECONSTRUCTION_WANDB_RUN=0 RECONSTRUCTION_WANDB_CHECKPOINT_ARTIFACTS=0 RECONSTRUCTION_WANDB_PROJECT=DELight_Reconstruction_Pairwise_Compact RECONSTRUCTION_WANDB_RUN_NAME=pairwise_compact_l40s_20260622_160152 RECONSTRUCTION_CHECKPOINT_DIR=artifacts/pairwise_compact_l40s/checkpoints/20260622_160152 RECONSTRUCTION_DISABLE_TORCH_COMPILE=1 TORCHDYNAMO_DISABLE=1"

Queue
